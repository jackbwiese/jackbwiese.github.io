---
import { t, tArr } from '../i18n/t.js';
const L = Astro.currentLocale;
const paragraphs = tArr(L, 'vita.paragraphs');
---
<section class="section vita" id="vita">
  <span class="eyebrow">{t(L, 'vita.eyebrow')}</span>

  <div class="bias-grid vita__grid">
    <div class="vita__portraits">
      <figure class="vita__figure vita__figure--main">
        <img
          src="/images/portrait-romulus-og.jpg"
          alt="Jack (B.) Wiese"
          width="1707"
          height="2560"
          loading="lazy"
        />
        <figcaption class="mono">{t(L, 'vita.portraitCaption')}</figcaption>
      </figure>
      <figure class="vita__figure vita__figure--offset">
        <img
          src="/images/portrait-black-tee.jpg"
          alt="Jack (B.) Wiese"
          width="1584"
          height="2560"
          loading="lazy"
        />
      </figure>
    </div>

    <div class="vita__text">
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </div>
</section>

<style>
  .vita {
    background: var(--otb-black);
    color: var(--otb-white);
  }
  .vita__grid {
    align-items: start;
    gap: clamp(2rem, 5vw, 5rem);
  }
  .vita__portraits {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2vw, 1.75rem);
  }
  .vita__figure {
    margin: 0;
    position: relative;
    width: 100%;
  }
  .vita__figure img {
    width: 100%;
    height: auto;
    filter: contrast(1.08) saturate(0.88) brightness(0.96);
    display: block;
  }
  .vita__figure--main {
    max-width: 70%;
  }
  .vita__figure--offset {
    max-width: 55%;
    margin-left: auto;
  }
  .vita__figure figcaption {
    margin-top: 0.65rem;
    color: var(--otb-mid-gray);
  }
  .vita__text {
    padding-top: 0.25rem;
    color: var(--otb-light-gray);
  }
  .vita__text p {
    font-size: var(--scale-lede);
    line-height: 1.5;
    max-width: 56ch;
  }
  .vita__text strong {
    font-weight: 500;
    color: var(--otb-white);
  }
  .vita__text em {
    color: var(--otb-white);
  }
</style>
