---
import { t, tArr } from '../i18n/t.js';
const L = Astro.currentLocale;
const paragraphs = tArr(L, 'vita.paragraphs');
---
<section class="section vita" id="vita">
  <span class="eyebrow">{t(L, 'vita.eyebrow')}</span>

  <div class="bias-grid vita__grid">
    <div class="vita__portraits">
      <figure class="vita__figure vita__figure--main">
        <img
          src="/images/portrait-romulus-carre.jpg"
          alt="Jack (B.) Wiese"
          width="1200"
          height="1200"
          loading="lazy"
        />
        <figcaption class="mono">{t(L, 'vita.portraitCaption')}</figcaption>
      </figure>
      <figure class="vita__figure vita__figure--thumb vita__figure--left">
        <img
          src="/images/portrait-black-tee.jpg"
          alt="Jack (B.) Wiese"
          width="1584"
          height="2560"
          loading="lazy"
        />
      </figure>
      <figure class="vita__figure vita__figure--thumb vita__figure--right">
        <img
          src="/images/portrait-og-teddy.jpg"
          alt="Jack (B.) Wiese"
          loading="lazy"
        />
      </figure>
    </div>

    <div class="vita__text">
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </div>
</section>

<style>
  .vita {
    background: var(--otb-black);
    color: var(--otb-white);
  }
  .vita__grid {
    align-items: stretch;
    gap: clamp(2rem, 5vw, 5rem);
  }
  .vita__portraits {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: clamp(0.5rem, 1vw, 1rem);
    height: 100%;
  }
  .vita__figure {
    margin: 0;
    position: relative;
    min-width: 0;
    min-height: 0;
  }
  .vita__figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.08) saturate(0.88) brightness(0.96);
    display: block;
  }
  .vita__figure--main {
    grid-column: 1 / -1;
  }
  .vita__figure figcaption {
    margin-top: 0.65rem;
    color: var(--otb-mid-gray);
  }
  .vita__text {
    padding-top: 0.25rem;
    color: var(--otb-light-gray);
  }
  .vita__text p {
    font-size: var(--scale-lede);
    line-height: 1.5;
    max-width: 56ch;
  }
  .vita__text strong {
    font-weight: 500;
    color: var(--otb-white);
  }
  .vita__text em {
    color: var(--otb-white);
  }
</style>
