---
const phrases = [
  { lang: 'EN', text: 'My life purpose: proliferate creative expression in the physical world and lay the foundation for a global human renaissance.' },
  { lang: 'FR', text: "Le but de ma vie : proliférer l'expression créative dans le monde physique et poser les fondations d'une renaissance humaine mondiale." },
  { lang: 'IT', text: "Lo scopo della mia vita: proliferare l'espressione creativa nel mondo fisico e porre le fondamenta di una rinascita umana globale." },
  { lang: 'ES', text: 'El propósito de mi vida: proliferar la expresión creativa en el mundo físico y sentar las bases de un renacimiento humano global.' },
  { lang: 'DE', text: 'Der Zweck meines Lebens: kreativen Ausdruck in der physischen Welt zu verbreiten und das Fundament für eine globale menschliche Renaissance zu legen.' },
  { lang: 'EL', text: 'Ο σκοπός της ζωής μου: να διαδώσω τη δημιουργική έκφραση στον φυσικό κόσμο και να θέσω τα θεμέλια για μια παγκόσμια ανθρώπινη αναγέννηση.' },
];
---
<div class="lang" aria-live="polite">
  <span class="lang__chip" data-lang>{phrases[0].lang}</span>
  <span class="lang__text" data-text>{phrases[0].text}</span>
</div>

<script type="application/json" id="jw-phrases" set:html={JSON.stringify(phrases)}></script>

<style>
  .lang {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    font-family: 'NHaas Display';
    font-weight: 300;
    font-size: clamp(1rem, 2.1vw, 1.55rem);
    letter-spacing: var(--track-tight);
    line-height: 1.32;
    max-width: 62ch;
  }
  .lang__text {
    display: inline-block;
  }
  .lang__chip {
    font-family: 'NHaas Text';
    font-size: 0.65rem;
    letter-spacing: var(--track-upper);
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--accent);
    padding: 0.2rem 0.45rem 0.16rem;
    transform: translateY(-0.18em);
    min-width: 2.3rem;
    text-align: center;
    transition: opacity 220ms ease;
  }
  .lang__text {
    transition: opacity 280ms ease;
    will-change: opacity;
  }
  .lang.is-fade .lang__text,
  .lang.is-fade .lang__chip {
    opacity: 0;
  }
</style>

<script is:inline>
  (() => {
    const data = JSON.parse(document.getElementById('jw-phrases').textContent);
    const root = document.querySelector('.lang');
    if (!root) return;
    const chip = root.querySelector('[data-lang]');
    const txt = root.querySelector('[data-text]');
    let i = 0;
    const tick = () => {
      root.classList.add('is-fade');
      setTimeout(() => {
        i = (i + 1) % data.length;
        chip.textContent = data[i].lang;
        txt.textContent = data[i].text;
        root.classList.remove('is-fade');
      }, 320);
    };
    setInterval(tick, 6500);
  })();
</script>
